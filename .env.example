# Nimble (Phase 1) configuration.
#
# The Ollama server is NOT assumed to be local: override OLLAMA_BASE_URL for
# any remote or containerized deployment.
OLLAMA_BASE_URL=http://localhost:11434

# Name of the Nimble decision model served by the Ollama-compatible backend.
NIMBLE_MODEL=nimble

# Optional per-request timeout for Nimble/Ollama calls (Go duration syntax).
NIMBLE_TIMEOUT=30s
