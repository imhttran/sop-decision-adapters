# Provider configuration (Nimble, Julia, and Clef).

# The Ollama server is NOT assumed to be local: override OLLAMA_BASE_URL for
# any remote or containerized deployment.
OLLAMA_BASE_URL=http://localhost:11434

# Name of the Nimble decision model served by the Ollama-compatible backend.
NIMBLE_MODEL=nimble

# Optional per-request timeout for Nimble/Ollama calls (Go duration syntax).
NIMBLE_TIMEOUT=30s

# --- Julia (ONNX) provider ---

# Model identifier reported as DecisionResult.Model when the runner does not
# report one.
JULIA_MODEL=julia

# Path to the ONNX model. Required by the default helper (tools/julia/infer.py);
# the model itself is not committed here. Forwarded to the helper as
# JULIA_MODEL_PATH.
JULIA_MODEL_PATH=

# Interpreter for the default helper. Ignored when JULIA_INFERENCE_CMD is set.
JULIA_PYTHON=python3

# Optional override for the inference command, whitespace-split into argv (shell
# quoting rules are not applied). Leave empty to use the repository-owned helper
# tools/julia/infer.py.
JULIA_INFERENCE_CMD=

# Tokenizer for the helper (default: tokenizer.json beside the model).
JULIA_TOKENIZER_PATH=

# Encoder context limit used by the helper.
JULIA_MAX_TOKENS=8192

# Inference timeout (Go duration syntax).
JULIA_TIMEOUT=30s

# --- Clef provider ---

# Clef is OFF by default. Explicit operator action required to activate.
# CLEF_ENABLED=1

# Name of the Clef decision model served by the Ollama-compatible backend.
# CLEF_MODEL=clef-flash

# Optional per-request timeout for Clef/Ollama calls (Go duration syntax).
# CLEF_TIMEOUT=30s
