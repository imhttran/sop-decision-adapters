# Provider configuration (Nimble and Julia).
#
# The Ollama server is NOT assumed to be local: override OLLAMA_BASE_URL for
# any remote or containerized deployment.
OLLAMA_BASE_URL=http://localhost:11434

# Name of the Nimble decision model served by the Ollama-compatible backend.
NIMBLE_MODEL=nimble

# Optional per-request timeout for Nimble/Ollama calls (Go duration syntax).
NIMBLE_TIMEOUT=30s

# --- Julia (ONNX) provider ---

# Model identifier reported as DecisionResult.Model when the runner does not
# report one.
JULIA_MODEL=julia

# External inference command, whitespace-split into argv (shell quoting rules
# are not applied). Empty => the Julia provider reports unavailable.
JULIA_INFERENCE_CMD=

# Path to the ONNX model; forwarded to the inference command as
# JULIA_MODEL_PATH.
JULIA_MODEL_PATH=

# Inference timeout (Go duration syntax).
JULIA_TIMEOUT=30s
